{
  "name": "magiccard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gh": "BASE_PATH=/magiccard/ tsc -b && BASE_PATH=/magiccard/ vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.26.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
